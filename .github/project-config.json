{
  "name": "Hentai-Senpai GTK Theme",
  "description": "Project board for tracking theme development, documentation, and releases",
  "readme": "docs/PROJECT_WORKFLOW.md",
  "fields": [
    {
      "name": "Priority",
      "type": "single_select",
      "options": [
        {"name": "🔴 Critical", "color": "#FF0000", "description": "Blocking, fix immediately"},
        {"name": "🟠 High", "color": "#FF8C00", "description": "Important, do soon"},
        {"name": "🟡 Medium", "color": "#FFD700", "description": "Normal priority"},
        {"name": "🟢 Low", "color": "#32CD32", "description": "Nice to have"}
      ]
    },
    {
      "name": "Size",
      "type": "single_select",
      "options": [
        {"name": "XS", "color": "#C0C0C0", "description": "Extra small (1-2 hours)"},
        {"name": "S", "color": "#87CEEB", "description": "Small (half day)"},
        {"name": "M", "color": "#98FB98", "description": "Medium (1-2 days)"},
        {"name": "L", "color": "#FFB6C1", "description": "Large (3-5 days)"},
        {"name": "XL", "color": "#DDA0DD", "description": "Extra large (1+ weeks)"}
      ]
    },
    {
      "name": "Component",
      "type": "single_select",
      "options": [
        {"name": "GTK2", "color": "#8B4513", "description": "GTK2 theme files"},
        {"name": "GTK3", "color": "#CD853F", "description": "GTK3 theme files"},
        {"name": "GTK4", "color": "#D2691E", "description": "GTK4 theme files"},
        {"name": "GNOME Shell", "color": "#4B0082", "description": "GNOME Shell theme"},
        {"name": "Cinnamon", "color": "#800080", "description": "Cinnamon theme"},
        {"name": "XFWM", "color": "#9370DB", "description": "XFWM theme"},
        {"name": "Documentation", "color": "#4169E1", "description": "Wiki and docs"},
        {"name": "Scripts", "color": "#228B22", "description": "Installation scripts"},
        {"name": "CI/CD", "color": "#DC143C", "description": "Workflows and automation"}
      ]
    },
    {
      "name": "Effort",
      "type": "number",
      "description": "Estimated effort in hours or story points"
    },
    {
      "name": "Started",
      "type": "date",
      "description": "When work began on this item"
    },
    {
      "name": "Completed",
      "type": "date",
      "description": "When work was completed"
    }
  ],
  "views": [
    {
      "name": "📋 Board",
      "type": "board",
      "columns": [
        {"name": "📥 Backlog", "description": "Unprioritized items"},
        {"name": "📝 Todo", "description": "Ready to work"},
        {"name": "🏃 In Progress", "description": "Being worked on"},
        {"name": "👀 In Review", "description": "Ready for review"},
        {"name": "✅ Done", "description": "Completed"}
      ]
    },
    {
      "name": "📅 Roadmap",
      "type": "roadmap",
      "group_by": "sprint"
    },
    {
      "name": "📊 Table",
      "type": "table",
      "fields": ["title", "assignees", "status", "priority", "size", "component", "labels"]
    },
    {
      "name": "🐛 Bugs",
      "type": "board",
      "filter": {"labels": ["type: bug"]},
      "columns": ["Todo", "In Progress", "In Review", "Done"]
    },
    {
      "name": "✨ Features",
      "type": "board",
      "filter": {"labels": ["type: feature"]},
      "columns": ["Todo", "In Progress", "In Review", "Done"]
    }
  ],
  "automation": {
    "auto_add_to_project": true,
    "auto_archive": {
      "enabled": true,
      "days_after_completion": 30
    },
    "status_sync": {
      "issue_opened": "Todo",
      "issue_closed": "Done",
      "pr_opened": "In Progress",
      "pr_draft": "Todo",
      "pr_ready_for_review": "In Review",
      "pr_merged": "Done",
      "pr_closed": "Done"
    }
  }
}
